{
  "name": "shipnow-back-end-iii",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "ShipNow: documentación OpenAPI con Swagger UI, mocks, logging y errores centralizados",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
