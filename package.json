    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "chai": "^6.3.0",
    "mocha": "^12.0.3",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  }
}
